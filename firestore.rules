rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the site owner may write or read drafts.
    // REPLACE the UID below with your own: Firebase Console -> Authentication ->
    // Users -> copy the "User UID" of your admin account. Then deploy with:
    //   firebase deploy --only firestore:rules
    function isOwner() {
      return request.auth != null
             && request.auth.uid == 'UoxAz1usSfenKjWQGRteuRlnnOD3';
    }

    // Published content is world-readable; unpublished (drafts) only to the owner.
    // Writes are owner-only across every collection.
    match /blog_posts/{postId} {
      allow read: if resource.data.isPublished == true || isOwner();
      allow write: if isOwner();
    }

    match /diary_entries/{entryId} {
      allow read: if resource.data.isPublished == true || isOwner();
      allow write: if isOwner();
    }

    match /projects/{projectId} {
      allow read: if resource.data.isPublished == true || isOwner();
      allow write: if isOwner();
    }

    match /memories/{memoryId} {
      allow read: if resource.data.isPublished == true || isOwner();
      allow write: if isOwner();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
