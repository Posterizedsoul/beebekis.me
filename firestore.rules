rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Blog posts - public read for published OR auth user, auth required for write
    match /blog_posts/{postId} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Diary entries - public read for published OR auth user, auth required for write
    match /diary_entries/{entryId} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Projects - public read for published OR auth user, auth required for write
    match /projects/{projectId} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Memories - public read for published OR auth user, auth required for write
    match /memories/{memoryId} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
